{
  "name": "jobwars-pvp",
  "main": "workers/pvp.ts",
  "compatibility_date": "2026-11-26",
  "build": { "command": "node tools/room-version.mjs --check" },
  "vars": {
    "WEB_ORIGINS": "https://jobwars.vercel.app,http://localhost:5173,http://127.0.0.1:5173"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PvpRoom" },
      { "name": "QUEUE", "class_name": "PvpQueue" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PvpRoom", "PvpQueue"] }
  ],
  "ratelimits": [
    { "name": "PVP_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ]
}
